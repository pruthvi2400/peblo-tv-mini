# Peblo TV Viewer - environment configuration
#
# Copy this file to `.env` (or `.env.local`) and adjust as needed.
# Vite exposes any variable prefixed with VITE_ to the client.

# Base URL of the FastAPI backend, including the protocol and port but
# WITHOUT a trailing slash. The Viewer API client will append the path
# segments defined per endpoint (only public /catalog/* routes).
VITE_API_BASE_URL=http://localhost:8000
