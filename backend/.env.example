# Database configuration
DATABASE_URL=postgresql://user:password@localhost:5432/peblo_tv

# ── JWT / Authentication configuration (Phase 5) ─────────────────────────────
# REQUIRED in any non-test deployment. The development default in
# app/core/config.py is intentionally obvious so it can never be
# mistaken for a real secret.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=replace-me-with-a-real-secret

# Algorithm used to sign access tokens. Default HS256 is fine for a
# single-service deployment.
# JWT_ALGORITHM=HS256

# Access-token lifetime in minutes. Defaults to 60.
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Dev-only seed users (Phase 5) ────────────────────────────────────────────
# Setting DEV_SEED_USERS=true causes the API to upsert the editor and
# admin accounts below on every startup. The passwords are written as
# bcrypt hashes, but the environment itself contains the plaintext so
# this MUST stay disabled in production.
DEV_SEED_USERS=false
DEV_EDITOR_EMAIL=editor@peblo.local
DEV_EDITOR_PASSWORD=changeme-editor
DEV_ADMIN_EMAIL=admin@peblo.local
DEV_ADMIN_PASSWORD=changeme-admin

# Server configuration
HOST=0.0.0.0
PORT=8000

# Logging configuration
LOG_LEVEL=INFO

# Storage configuration (Phase 4)
# STORAGE_BACKEND selects the storage implementation:
#   "local"  - writes to STORAGE_LOCAL_ROOT (development).
#   "r2"     - placeholder; production swap-in for Phase 6+.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./_storage
# URL prefix served by the local storage static-mount (development only).
STORAGE_LOCAL_URL_PREFIX=/storage