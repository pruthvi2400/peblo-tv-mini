# Peblo TV Environment Variables
# Copy to .env and fill in values

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://peblo:peblo_secret@postgres:5432/peblo_tv

# =============================================================================
# AUTHENTICATION (REQUIRED IN PRODUCTION)
# =============================================================================
# JWT secret - MUST be changed in production (min 32 bytes for HS256)
JWT_SECRET_KEY=dev-only-do-not-use-in-production-please

# Token settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# DEVELOPMENT SEED USERS (NEVER ENABLE IN PRODUCTION)
# =============================================================================
DEV_SEED_USERS=false
DEV_EDITOR_EMAIL=editor@peblo.tv
DEV_EDITOR_PASSWORD=change_me
DEV_ADMIN_EMAIL=admin@peblo.tv
DEV_ADMIN_PASSWORD=change_me

# =============================================================================
# SERVER
# =============================================================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# =============================================================================
# STORAGE
# =============================================================================
# Backend: 'local' for filesystem, 'r2' for Cloudflare R2
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./_storage
STORAGE_LOCAL_URL_PREFIX=/storage

# For R2 storage (when STORAGE_BACKEND=r2)
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key
# R2_SECRET_ACCESS_KEY=your_secret_key
# R2_BUCKET_NAME=peblo-tv-storage
# R2_PUBLIC_URL=https://pub.yourdomain.com

# =============================================================================
# FRONTEND (set by docker-compose, override for local dev)
# =============================================================================
VITE_API_BASE_URL=http://localhost:8000
